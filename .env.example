# Скопируйте в .env и заполните. .env не коммитится.

# --- Безопасность ---
SECRET_KEY=replace-with-long-random-string

# --- База и очередь (в docker-compose хосты postgres/redis) ---
DATABASE_URL=postgresql+asyncpg://sm:sm@localhost:5432/sm
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- AI через OpenRouter: https://openrouter.ai/settings/keys ---
OPENROUTER_API_KEY=
# Модели по задачам AI Router. ID сверять на https://openrouter.ai/models
LLM_MODEL_ANALYZE=qwen/qwen3.8-max
LLM_MODEL_CLASSIFY=qwen/qwen3.8-flash
LLM_MODEL_WRITE=qwen/qwen3.8-max
LLM_MODEL_QA=qwen/qwen3.8-flash

# --- Эмбеддинги (EPIC 3) ---
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# --- Сбор источников (значения по умолчанию подходят) ---
# SOURCE_HISTORY_DAYS=90
# DOMAIN_MIN_INTERVAL_SEC=1.5
# TELEGRAM_MAX_PAGES=15

# --- Опциональные коннекторы (EPIC 2+), без ключа источник просто недоступен ---
APIFY_TOKEN=
YOUTUBE_API_KEY=
VK_SERVICE_TOKEN=
