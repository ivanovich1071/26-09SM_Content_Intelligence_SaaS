# Скопируйте в .env и заполните. .env не коммитится.

# --- Безопасность ---
SECRET_KEY=replace-with-long-random-string
# Суперадмины (раздел «Админка»): email через запятую, права выдаются при входе.
# Или: docker compose exec api python -m app.admin.cli grant you@company.by
SUPERADMIN_EMAILS=

# --- База и очередь (в docker-compose хосты postgres/redis) ---
DATABASE_URL=postgresql+asyncpg://sm:sm@localhost:5432/sm
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- AI через OpenRouter: https://openrouter.ai/settings/keys ---
OPENROUTER_API_KEY=
# Модели по задачам AI Router. ID сверять на https://openrouter.ai/models
LLM_MODEL_ANALYZE=qwen/qwen3.8-max
LLM_MODEL_CLASSIFY=qwen/qwen3.8-flash
LLM_MODEL_WRITE=qwen/qwen3.8-max
LLM_MODEL_QA=qwen/qwen3.8-flash

# --- Эмбеддинги (EPIC 3) ---
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# --- Анализ (EPIC 3): без OPENROUTER_API_KEY считаются только метрики и дубли ---
# CLASSIFY_MAX_POSTS_PER_JOB=300
# SEMANTIC_DUP_DISTANCE=0.05

# --- Сайты (EPIC 7) ---
# WEBSITE_CRAWL_DAYS=7

# --- Аудит контента (EPIC 8) ---
# AUDIT_DAYS=90
# AUDIT_MAX_POSTS=40
# AUDIT_MIN_MARKET_POSTS=30
# Публичный аудит без регистрации: лимит на IP/email и общий суточный потолок (бюджет LLM)
# PUBLIC_AUDITS_PER_IP_DAY=1
# PUBLIC_AUDITS_PER_DAY=100
# Капча Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile). Пусто — без капчи.
# Секрет — бэкенду, site key — фронту при сборке.
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# За своим reverse-proxy: брать IP из X-Forwarded-For
# TRUST_PROXY_HEADERS=false

# --- Дайджест (EPIC 11): email через SMTP; без SMTP_HOST — только web, .md/.html и PDF ---
SMTP_HOST=
# SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_TLS=true          # STARTTLS; для порта 465 — SMTP_SSL=true
# APP_URL=http://localhost:3000   # ссылка «открыть в сервисе» в письме

# --- Content Strategy (EPIC 9) ---
# STRATEGY_DAYS=90
# STRATEGY_MIN_MARKET_POSTS=20

# --- Сбор источников (значения по умолчанию подходят) ---
# SOURCE_HISTORY_DAYS=90
# DOMAIN_MIN_INTERVAL_SEC=1.5
# TELEGRAM_MAX_PAGES=15

# --- Опциональные коннекторы (EPIC 2+), без ключа источник просто недоступен ---
# Instagram собирается через Apify: https://console.apify.com/settings/integrations (бесплатно $5/мес)
APIFY_TOKEN=
# YouTube собирается без ключа (RSS канала); ключ зарезервирован на будущее
YOUTUBE_API_KEY=
# VK: сервисный ключ приложения — https://id.vk.com/about/business/go (Мои приложения → ключ доступа)
VK_SERVICE_TOKEN=
